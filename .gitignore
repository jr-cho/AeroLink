# ---------------------------------------------------------------
# Secrets and environment
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# MQTT certificates, keys, and password files (generated by mosquitto/make-ca.sh)
mosquitto/certs/
mosquitto/passwd
*.key
*.pem
*.p12

# ---------------------------------------------------------------
# Python (backend/)
# ---------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
# Keep backend/uv.lock and backend/.python-version committed (CI needs them)

# Hugging Face / model caches (Chronos-2 weights are downloaded, not committed)
.cache/
backend/.cache/

# Real-world data (adsb.lol, ODbL): reproduced by the pipeline, never committed
backend/data/realdata/
backend/data/raw/

# Scratch output from local runs (committed results live in backend/eval-results/)
backend/eval-results/tmp/

# ---------------------------------------------------------------
# Map page (web/, Vite + TypeScript)
# ---------------------------------------------------------------
web/node_modules/
web/dist/

# ---------------------------------------------------------------
# Firmware (ESP-IDF)
# ---------------------------------------------------------------
firmware/build/
firmware/managed_components/
firmware/sdkconfig
firmware/sdkconfig.old
# Keep firmware/sdkconfig.defaults and firmware/dependencies.lock committed

# ---------------------------------------------------------------
# Hardware (KiCad)
# ---------------------------------------------------------------
*-backups/
*.kicad_prl
fp-info-cache
*.lck
_autosave-*

# ---------------------------------------------------------------
# Local Docker data
# ---------------------------------------------------------------
pgdata/

# ---------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log

# Raw airspace / FDOT / FDEP downloads (large; reproducible)
airspace/source/

# Basemap and device tile set (large; reproducible)
basemap/
