# AeroLink: copy to .env and fill in. Never commit .env.

# General
# LOG_LEVEL: debug | info | warn | error
# AEROLINK_DOMAIN: localhost (local cert) | a real domain (Let's Encrypt) | :80 (plain HTTP behind `tailscale serve`)
AEROLINK_DOMAIN=localhost
# AEROLINK_SITE: public base URL printed in pairing QR codes (https://<site>/device/<id>?code=...)
AEROLINK_SITE=https://localhost
# Session cookie Secure flag for the pilot screen: keep 1 (also behind `tailscale serve`, where the browser sees
# HTTPS); 0 only for plain-HTTP local dev without TLS.
AEROLINK_COOKIE_SECURE=1
LOG_LEVEL=info

# Dashboard login (Caddy basic auth)
# Hash: docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
# Keep the single quotes around the hash (it contains $ signs).
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=''

# PostgreSQL
POSTGRES_DB=aerolink
POSTGRES_USER=aerolink
POSTGRES_PASSWORD=
# SQLAlchemy URL (asyncpg driver). compose.yaml sets this for the containers; this one is for
# running the backend on the host against the compose Postgres (localhost instead of postgres).
DATABASE_URL=postgresql+asyncpg://aerolink:${POSTGRES_PASSWORD}@postgres:5432/aerolink
TELEMETRY_RETENTION_DAYS=7

# MQTT
MQTT_HOST=mosquitto
# backend and sim use the internal listener (1883, compose network only); devices use 8883 + TLS
MQTT_PORT=1883
MQTT_TLS_ENABLED=false
MQTT_CA_FILE=/certs/ca.crt
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=
MQTT_SIM_USERNAME=sim
MQTT_SIM_PASSWORD=
# Test unit for scripts/broker-check.sh and the end-to-end test (account created by scripts/dev-setup.sh)
MQTT_TEST_UNIT_ID=dev-test
MQTT_TEST_UNIT_PASSWORD=

# Backend
# DEFAULT_FORECASTER: cv | chronos | aerolink-gbm
# DEFAULT_METHOD: classical | aerolink
DEFAULT_FORECASTER=chronos
DEFAULT_METHOD=aerolink
# HF_HOME: Hugging Face cache for the Chronos-2 weights (downloaded on first use); compose mounts the
# `model-cache` volume here so restarts do not re-download.
HF_HOME=/models/hf-cache
# Unit liveness (service/mqtt.py, E6.3/E6.9). Every message from a unit counts as a heartbeat; silent for longer than
# UNIT_SILENCE_SECONDS -> offline (the MQTT Last Will alone takes ~3 min when a unit is unplugged).
UNIT_SILENCE_SECONDS=3.0
# Paired screens get a WebSocket heartbeat this often (the screen declares the link dead after ~12 s without one).
WS_HEARTBEAT_SECONDS=5
# Unit status "degraded" (E6.9): health heartbeat older than this | no GNSS fix for longer than this | Wi-Fi weaker than this
# HEALTH_STALE_SECONDS=30  NO_FIX_DEGRADED_SECONDS=10  RSSI_DEGRADED_DBM=-80
# Server watchdogs are re-evaluated this often (GET /healthz?deep=1 shows them)
# WATCHDOG_INTERVAL_SECONDS=5
# Optional (defaults in service/settings.py): load models at start | off-route check period | sim track expiry
# PRELOAD_MODELS=true
# OFFROUTE_INTERVAL_SECONDS=10
# SIM_TRACK_TTL_SECONDS=60
# Optional path overrides (the image already has everything at the defaults)
# MODELS_DIR=  EVAL_DIR=  SCENARIOS_DIR=  CONSTRAINTS_FILE=

# torch (Chronos) and LightGBM each ship an OpenMP runtime; on macOS loading both in one process hangs or crashes
# unless OpenMP is single-threaded. compose.yaml sets it for the backend container; set it when running on the host.
OMP_NUM_THREADS=1

# Live ADS-B background traffic (adsb.lol public API, no key; ODbL). The API allows 500 requests per 24 h, so
# polling is adaptive: every ACTIVE seconds while someone uses /api/adsb, /api/ops/* or /ws/ops (last 2 min),
# every IDLE seconds otherwise, never more than DAILY_BUDGET requests per rolling 24 h (the interval stretches as
# the budget runs down). ADSB_POLL_SECONDS (old) is gone.
ADSB_ENABLED=true
ADSB_POLL_ACTIVE_SECONDS=30
ADSB_POLL_IDLE_SECONDS=300
ADSB_DAILY_BUDGET=450
# ADSB_URL: blank = the default adsb.lol endpoint
ADSB_URL=

# Route engine loops (ARCHITECTURE §8)
FORECAST_REFRESH_SECONDS=10
TRAFFIC_PUBLISH_SECONDS=5
SUGGESTION_INTERVAL_SECONDS=120

# Container images (compose.yaml): local build by default; on a server point at Artifact Registry
# IMAGE_REGISTRY=<region>-docker.pkg.dev/<project>/<repository>   IMAGE_TAG=<git sha> | main
IMAGE_REGISTRY=local
IMAGE_TAG=dev

# Simulator
SIM_SCENARIO=nominal_day
SIM_SEED=42

# LLM route summary (OpenAI-compatible API). No default endpoint: leave LLM_BASE_URL blank and the route summary is
# the template (no LLM). Set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY to use a model server of your choice.
# LLM_MODEL: any model ID the server offers
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# LLM_REASONING_EFFORT: none | low | medium | high, sent as reasoning_effort (none stops reasoning models from spending
# the token budget thinking). Blank = do not send the parameter (for providers that reject it).
LLM_REASONING_EFFORT=none

# Backups (production)
BACKUP_GCS_BUCKET=
BACKUP_RETENTION_DAYS=14
