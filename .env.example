# AeroLink: copy to .env and fill in. Never commit .env.

# General
# LOG_LEVEL: debug | info | warn | error
AEROLINK_DOMAIN=localhost
LOG_LEVEL=info

# Dashboard login (Caddy basic auth)
# Hash: caddy hash-password --plaintext '<password>'
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=

# PostgreSQL
POSTGRES_DB=aerolink
POSTGRES_USER=aerolink
POSTGRES_PASSWORD=
DATABASE_URL=postgres://aerolink:${POSTGRES_PASSWORD}@postgres:5432/aerolink?sslmode=disable
TELEMETRY_RETENTION_DAYS=7

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_CA_FILE=/certs/ca.crt
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=
MQTT_SIM_USERNAME=sim
MQTT_SIM_PASSWORD=

# Backend
# DEFAULT_FORECASTER: cv | chronos | aerolink-gbm
# DEFAULT_METHOD: classical | aerolink
DEFAULT_FORECASTER=chronos
DEFAULT_METHOD=aerolink
HF_HOME=/models/hf-cache

# Route engine loops (ARCHITECTURE §8)
FORECAST_REFRESH_SECONDS=10
TRAFFIC_PUBLISH_SECONDS=5
SUGGESTION_INTERVAL_SECONDS=120

# Simulator
SIM_SCENARIO=nominal_day
SIM_SEED=42

# LLM route summary (OpenRouter, OpenAI-compatible API)
# LLM_MODEL: any model ID from openrouter.ai/models
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=

# Backups (production)
BACKUP_GCS_BUCKET=
BACKUP_RETENTION_DAYS=14
